---
import { Image } from "astro:assets";
import img1 from '../assets/gallery/1.png';
import img2 from '../assets/gallery/2.png';
import img3 from '../assets/gallery/3.png';
import img4 from '../assets/gallery/4.png';
import img5 from '../assets/gallery/5.png';
import img6 from '../assets/gallery/6.png';
---

<section id="servicios" class="py-28 md:py-40 bg-[var(--accent)] relative overflow-hidden">
  <div class="absolute inset-0 opacity-5">
    <div class="absolute top-0 right-0 w-[600px] h-[600px] rounded-full bg-[var(--highlight)] blur-[200px]"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] rounded-full bg-[var(--secondary-accent)] blur-[150px]"></div>
  </div>

  <div class="max-w-[1320px] mx-auto px-6 md:px-10 relative z-10">
    <div id="services-header" class="mb-20">
      <span class="label !text-[var(--highlight)] mb-5 block">Servicios</span>
      <h2 class="font-display text-[clamp(32px,5vw,56px)] font-medium leading-[1.05] text-white mb-6 max-w-[700px]">
        Capacidades que transforman ideas en <span class="italic text-[var(--highlight)]">productos premium</span>
      </h2>
      <p class="body-lg !text-white/50 max-w-[500px]">
        Cada servicio está diseñado para elevar la percepción de tu marca con resultados que impactan visualmente.
      </p>
    </div>

    <div id="services-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="service-item group relative bg-gradient-to-br from-white/[0.07] to-transparent rounded-[var(--radius-xl)] p-8 border border-white/10 hover:border-white/20 hover:-translate-y-1 transition-all duration-[var(--duration-hover)] overflow-hidden cursor-default">
        <div class="absolute top-0 right-0 w-32 h-32 bg-[var(--highlight)]/10 rounded-full blur-[60px] group-hover:bg-[var(--highlight)]/25 group-hover:scale-125 transition-all duration-[var(--duration-hover)]"></div>
        <div class="relative z-10">
          <div class="w-14 h-14 rounded-[var(--radius-md)] bg-[var(--highlight)]/15 flex items-center justify-center mb-6 group-hover:scale-110 group-hover:bg-[var(--highlight)]/25 transition-all duration-[var(--duration-hover)]">
            <svg class="w-7 h-7 text-[var(--highlight)]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" /></svg>
          </div>
          <h3 class="text-[20px] font-semibold text-white mb-3 group-hover:text-[var(--highlight)] transition-colors duration-[var(--duration-hover)]">Sublimación</h3>
          <p class="body-md !text-white/50 leading-relaxed break-words">Colores vibrantes y duraderos en tazas, termos y artículos personalizados con acabado premium.</p>
        </div>
      </div>

      <div class="service-item group relative bg-gradient-to-br from-white/[0.07] to-transparent rounded-[var(--radius-xl)] p-8 border border-white/10 hover:border-white/20 hover:-translate-y-1 transition-all duration-[var(--duration-hover)] overflow-hidden cursor-default">
        <div class="absolute top-0 right-0 w-32 h-32 bg-[var(--secondary-accent)]/10 rounded-full blur-[60px] group-hover:bg-[var(--secondary-accent)]/25 group-hover:scale-125 transition-all duration-[var(--duration-hover)]"></div>
        <div class="relative z-10">
          <div class="w-14 h-14 rounded-[var(--radius-md)] bg-[var(--secondary-accent)]/15 flex items-center justify-center mb-6 group-hover:scale-110 group-hover:bg-[var(--secondary-accent)]/25 transition-all duration-[var(--duration-hover)]">
            <svg class="w-7 h-7 text-[var(--secondary-accent)]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3L9 6H5.5a.75.75 0 00-.75.75v2.25l2.25 1.5V21h10.5v-10.5l2.25-1.5V6.75A.75.75 0 0018.5 6H15L12 3z" /></svg>
          </div>
          <h3 class="text-[20px] font-semibold text-white mb-3 group-hover:text-[var(--secondary-accent)] transition-colors duration-[var(--duration-hover)]">Estampados</h3>
          <p class="body-md !text-white/50 leading-relaxed break-words">Prendas con identidad. Estampados que comunican tu esencia con calidad superior.</p>
        </div>
      </div>

      <div class="service-item group relative bg-gradient-to-br from-white/[0.07] to-transparent rounded-[var(--radius-xl)] p-8 border border-white/10 hover:border-white/20 hover:-translate-y-1 transition-all duration-[var(--duration-hover)] overflow-hidden cursor-default">
        <div class="absolute top-0 right-0 w-32 h-32 bg-[var(--highlight)]/10 rounded-full blur-[60px] group-hover:bg-[var(--highlight)]/25 group-hover:scale-125 transition-all duration-[var(--duration-hover)]"></div>
        <div class="relative z-10">
          <div class="w-14 h-14 rounded-[var(--radius-md)] bg-[var(--highlight)]/15 flex items-center justify-center mb-6 group-hover:scale-110 group-hover:bg-[var(--highlight)]/25 transition-all duration-[var(--duration-hover)]">
            <svg class="w-7 h-7 text-[var(--highlight)]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0110.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0l.229 2.523a1.125 1.125 0 01-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0021 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 00-1.913-.247M6.34 18H5.25A2.25 2.25 0 013 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 011.913-.247m10.5 0a48.536 48.536 0 00-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5zm-3 0h.008v.008H15V10.5z" /></svg>
          </div>
          <h3 class="text-[20px] font-semibold text-white mb-3 group-hover:text-[var(--highlight)] transition-colors duration-[var(--duration-hover)]">Impresiones</h3>
          <p class="body-md !text-white/50 leading-relaxed break-words">Impresiones nítidas en diversos materiales para tu marca o producto con alta resolución.</p>
        </div>
      </div>

      <div class="service-item group relative bg-gradient-to-br from-white/[0.07] to-transparent rounded-[var(--radius-xl)] p-8 border border-white/10 hover:border-white/20 hover:-translate-y-1 transition-all duration-[var(--duration-hover)] overflow-hidden cursor-default">
        <div class="absolute top-0 right-0 w-32 h-32 bg-[var(--secondary-accent)]/10 rounded-full blur-[60px] group-hover:bg-[var(--secondary-accent)]/25 group-hover:scale-125 transition-all duration-[var(--duration-hover)]"></div>
        <div class="relative z-10">
          <div class="w-14 h-14 rounded-[var(--radius-md)] bg-[var(--secondary-accent)]/15 flex items-center justify-center mb-6 group-hover:scale-110 group-hover:bg-[var(--secondary-accent)]/25 transition-all duration-[var(--duration-hover)]">
            <svg class="w-7 h-7 text-[var(--secondary-accent)]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" /></svg>
          </div>
          <h3 class="text-[20px] font-semibold text-white mb-3 group-hover:text-[var(--secondary-accent)] transition-colors duration-[var(--duration-hover)]">Regalos Corporativos</h3>
          <p class="body-md !text-white/50 leading-relaxed break-words">Productos únicos que fortalecen relaciones y comunican tu marca efectivamente.</p>
        </div>
      </div>

      <div class="service-item group relative bg-gradient-to-br from-white/[0.07] to-transparent rounded-[var(--radius-xl)] p-8 border border-white/10 hover:border-white/20 hover:-translate-y-1 transition-all duration-[var(--duration-hover)] overflow-hidden cursor-default">
        <div class="absolute top-0 right-0 w-32 h-32 bg-[var(--highlight)]/10 rounded-full blur-[60px] group-hover:bg-[var(--highlight)]/25 group-hover:scale-125 transition-all duration-[var(--duration-hover)]"></div>
        <div class="relative z-10">
          <div class="w-14 h-14 rounded-[var(--radius-md)] bg-[var(--highlight)]/15 flex items-center justify-center mb-6 group-hover:scale-110 group-hover:bg-[var(--highlight)]/25 transition-all duration-[var(--duration-hover)]">
            <svg class="w-7 h-7 text-[var(--highlight)]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42" /></svg>
          </div>
          <h3 class="text-[20px] font-semibold text-white mb-3 group-hover:text-[var(--highlight)] transition-colors duration-[var(--duration-hover)]">Diseño Creativo</h3>
          <p class="body-md !text-white/50 leading-relaxed break-words">Conceptos visuales que elevan la percepción de tu marca con originalidad.</p>
        </div>
      </div>

      <div class="service-item group relative bg-gradient-to-br from-white/[0.07] to-transparent rounded-[var(--radius-xl)] p-8 border border-white/10 hover:border-white/20 hover:-translate-y-1 transition-all duration-[var(--duration-hover)] overflow-hidden cursor-default">
        <div class="absolute top-0 right-0 w-32 h-32 bg-[var(--secondary-accent)]/10 rounded-full blur-[60px] group-hover:bg-[var(--secondary-accent)]/25 group-hover:scale-125 transition-all duration-[var(--duration-hover)]"></div>
        <div class="relative z-10">
          <div class="w-14 h-14 rounded-[var(--radius-md)] bg-[var(--secondary-accent)]/15 flex items-center justify-center mb-6 group-hover:scale-110 group-hover:bg-[var(--secondary-accent)]/25 transition-all duration-[var(--duration-hover)]">
            <svg class="w-7 h-7 text-[var(--secondary-accent)]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
          </div>
          <h3 class="text-[20px] font-semibold text-white mb-3 group-hover:text-[var(--secondary-accent)] transition-colors duration-[var(--duration-hover)]">Material de Marca</h3>
          <p class="body-md !text-white/50 leading-relaxed break-words">Materiales que refuerzan la identidad visual de tu empresa con coherencia.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

gsap.registerPlugin(ScrollTrigger);
ScrollTrigger.config({ limitCallbacks: true });

document.addEventListener('DOMContentLoaded', () => {
  const isMobile = window.innerWidth < 768;
  const header = document.getElementById('services-header');
  const cards = document.querySelectorAll('.service-item');

  gsap.fromTo(header.querySelectorAll('span, h2, p'),
    { y: isMobile ? 15 : 25, opacity: 0 },
    {
      scrollTrigger: {
        trigger: header,
        start: 'top 85%',
        toggleActions: 'play none none none'
      },
      y: 0,
      opacity: 1,
      duration: 0.8,
      stagger: 0.1,
      ease: 'power3.out'
    }
  );

  gsap.fromTo(cards,
    { y: isMobile ? 20 : 30, opacity: 0 },
    {
      scrollTrigger: {
        trigger: '#services-grid',
        start: 'top 85%',
        toggleActions: 'play none none none'
      },
      y: 0,
      opacity: 1,
      duration: 0.8,
      stagger: isMobile ? 0.06 : 0.08,
      ease: 'power3.out'
    }
  );
});
</script>
