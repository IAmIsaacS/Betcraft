---
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50" style="background-color:transparent;box-shadow:none">
  <div class="max-w-[1320px] mx-auto px-6 md:px-10 flex items-center justify-between h-[72px] md:h-[80px]">
    <a href="#inicio" class="flex items-center gap-2.5 group">
      <span class="font-display text-[22px] font-semibold tracking-tight text-[var(--accent)] group-hover:text-[var(--highlight)] transition-colors duration-[var(--duration-hover)]">BetCraft</span>
    </a>

    <div class="hidden lg:flex items-center gap-10">
      <a href="#inicio" class="nav-link label">Inicio</a>
      <a href="#servicios" class="nav-link label">Servicios</a>
      <a href="#portfolio" class="nav-link label">Portafolio</a>
      <a href="#proceso" class="nav-link label">Proceso</a>
      <a href="#faq" class="nav-link label">FAQ</a>
    </div>

    <div class="flex items-center gap-5">
      <a href="#contacto" class="cta-desktop max-lg:hidden lg:inline-flex btn-dark !py-2.5 !px-6 !text-[11px]">
        Cotizar ahora
      </a>
      <button id="mobileMenuBtn" class="lg:hidden flex flex-col gap-[5px] p-2 cursor-pointer" aria-label="Abrir menú">
        <span class="hamburger-bar w-[22px]" id="bar1"></span>
        <span class="hamburger-bar w-[22px]" id="bar2"></span>
        <span class="hamburger-bar w-[15px]" id="bar3"></span>
      </button>
    </div>
  </div>

  <div id="mobileMenu" class="lg:hidden bg-[var(--page-bg)]/95 backdrop-blur-xl border-t border-[rgba(17,17,17,0.06)] hidden" aria-hidden="true">
    <div class="px-6 py-8 flex flex-col gap-1">
      <a href="#inicio" class="mobile-nav-link text-[16px] font-medium text-[var(--text)] hover:text-[var(--highlight)] hover:bg-[var(--highlight)]/5 rounded-[var(--radius-sm)] px-4 py-3 transition-all duration-[var(--duration-hover)]">Inicio</a>
      <a href="#servicios" class="mobile-nav-link text-[16px] font-medium text-[var(--text)] hover:text-[var(--highlight)] hover:bg-[var(--highlight)]/5 rounded-[var(--radius-sm)] px-4 py-3 transition-all duration-[var(--duration-hover)]">Servicios</a>
      <a href="#portfolio" class="mobile-nav-link text-[16px] font-medium text-[var(--text)] hover:text-[var(--highlight)] hover:bg-[var(--highlight)]/5 rounded-[var(--radius-sm)] px-4 py-3 transition-all duration-[var(--duration-hover)]">Portafolio</a>
      <a href="#proceso" class="mobile-nav-link text-[16px] font-medium text-[var(--text)] hover:text-[var(--highlight)] hover:bg-[var(--highlight)]/5 rounded-[var(--radius-sm)] px-4 py-3 transition-all duration-[var(--duration-hover)]">Proceso</a>
      <a href="#faq" class="mobile-nav-link text-[16px] font-medium text-[var(--text)] hover:text-[var(--highlight)] hover:bg-[var(--highlight)]/5 rounded-[var(--radius-sm)] px-4 py-3 transition-all duration-[var(--duration-hover)]">FAQ</a>
      <div class="mt-4 pt-4 border-t border-[rgba(17,17,17,0.06)]">
        <a href="#contacto" class="mobile-nav-link btn-dark w-full !justify-center !py-4 !text-[13px] !gap-3">
          Cotizar ahora
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";

gsap.registerPlugin(ScrollTrigger);

document.addEventListener('DOMContentLoaded', () => {
  const navbar = document.getElementById('navbar');
  const mobileMenuBtn = document.getElementById('mobileMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  const mobileLinks = mobileMenu.querySelectorAll('.mobile-nav-link');
  const navLinks = document.querySelectorAll('.nav-link');
  const bar1 = document.getElementById('bar1');
  const bar2 = document.getElementById('bar2');
  const bar3 = document.getElementById('bar3');
  let menuOpen = false;

  /* ── Navbar scroll effect ── */
  function updateNavbar() {
    const scrolled = window.scrollY > 80;
    if (scrolled) {
      navbar.style.backgroundColor = 'rgba(248, 246, 242, 0.92)';
      navbar.style.boxShadow = '0 1px 0 rgba(17,17,17,0.06)';
    } else {
      navbar.style.backgroundColor = 'transparent';
      navbar.style.boxShadow = 'none';
    }
  }

  /* ── Entrance animation (desktop only) ── */
  if (window.innerWidth >= 1024) {
    gsap.fromTo('#navbar .font-display',
      { y: -10, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.6, ease: 'power2.out', delay: 0.15 }
    );
    gsap.fromTo(navLinks,
      { y: -10, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.5, stagger: 0.06, ease: 'power2.out', delay: 0.35 }
    );
    gsap.fromTo('.cta-desktop',
      { y: -10, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.5, ease: 'power2.out', delay: 0.65 }
    );
  }

  /* ── Active section tracking ── */
  const sections = ['inicio', 'servicios', 'portfolio', 'proceso', 'faq'];
  sections.forEach(id => {
    const section = document.getElementById(id);
    const link = document.querySelector(`.nav-link[href="#${id}"]`);
    if (!section || !link) return;

    ScrollTrigger.create({
      trigger: section,
      start: 'top 40%',
      end: 'bottom 40%',
      onEnter: () => navLinks.forEach(l => l.classList.toggle('active', l === link)),
      onEnterBack: () => navLinks.forEach(l => l.classList.toggle('active', l === link))
    });
  });

  /* ── Mobile menu toggle ── */
  function openMenu() {
    menuOpen = true;
    mobileMenu.classList.remove('hidden');
    mobileMenu.setAttribute('aria-hidden', 'false');
    mobileMenuBtn.setAttribute('aria-label', 'Cerrar menú');

    gsap.set(mobileLinks, { x: 20, opacity: 0 });
    gsap.set(mobileMenu, { opacity: 1, maxHeight: mobileMenu.scrollHeight + 'px' });

    const tl = gsap.timeline();
    tl.to(mobileLinks, {
      x: 0,
      opacity: 1,
      duration: 0.4,
      stagger: 0.06,
      ease: 'power2.out'
    });

    gsap.to(bar1, { rotate: 45, y: 5, x: 5, width: 22, duration: 0.3, ease: 'power2.out' });
    gsap.to(bar2, { opacity: 0, duration: 0.2 });
    gsap.to(bar3, { rotate: -45, y: -4, x: 3, width: 22, duration: 0.3, ease: 'power2.out' });
  }

  function closeMenu() {
    menuOpen = false;
    mobileMenuBtn.setAttribute('aria-label', 'Abrir menú');

    const tl = gsap.timeline({
      onComplete: () => {
        mobileMenu.classList.add('hidden');
        mobileMenu.setAttribute('aria-hidden', 'true');
        gsap.set(mobileMenu, { clearProps: 'opacity,maxHeight' });
      }
    });
    tl.to(mobileLinks, {
      x: 20,
      opacity: 0,
      duration: 0.2,
      stagger: 0.03,
      ease: 'power2.in'
    })
    .to(mobileMenu, {
      maxHeight: 0,
      opacity: 0,
      duration: 0.3,
      ease: 'power3.in'
    }, '-=0.1');

    gsap.to(bar1, { rotate: 0, y: 0, x: 0, duration: 0.3, ease: 'power2.out' });
    gsap.to(bar2, { opacity: 1, duration: 0.2, delay: 0.1 });
    gsap.to(bar3, { rotate: 0, y: 0, x: 0, width: 15, duration: 0.3, ease: 'power2.out' });
  }

  mobileMenuBtn.addEventListener('click', () => {
    menuOpen ? closeMenu() : openMenu();
  });

  /* ── Smooth scroll on nav link clicks ── */
  document.querySelectorAll('.nav-link, .mobile-nav-link').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = link.getAttribute('href');
      const targetElement = document.querySelector(targetId);
      if (targetElement) {
        if (menuOpen) closeMenu();
        targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  updateNavbar();
  window.addEventListener('scroll', updateNavbar);
});
</script>

<style>
  #navbar {
    transition: background-color 1.2s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (max-width: 1023.98px) {
    .cta-desktop {
      display: none !important;
    }
  }

  #mobileMenu {
    opacity: 0;
    max-height: 0;
    overflow: hidden;
  }

  .nav-link {
    color: var(--muted);
    position: relative;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1.5px;
    background-color: var(--highlight);
    border-radius: 2px;
    transition: width 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
  }
  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  .hamburger-bar {
    display: block;
    height: 1.5px;
    background-color: var(--text);
    border-radius: 2px;
    transform-origin: center;
  }
</style>
