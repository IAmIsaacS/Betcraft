---
import { Image } from "astro:assets";
import img1 from '../assets/gallery/1.png';
import img2 from '../assets/gallery/2.png';
import img3 from '../assets/gallery/3.png';
import img4 from '../assets/gallery/4.png';
import img5 from '../assets/gallery/5.png';
import img6 from '../assets/gallery/6.png';
---

<section id="portfolio" class="py-28 md:py-40">
  <div class="max-w-[1320px] mx-auto px-6 md:px-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 md:mb-20 gap-6">
      <div>
        <span class="label mb-5 block">Portafolio</span>
        <h2 class="h1">Piezas con personalidad</h2>
      </div>
      <p class="body-lg max-w-[360px]">Cada proyecto refleja la identidad única de nuestra clientela.</p>
    </div>

    <div id="gallery-grid" class="flex flex-col gap-5">
      <div class="flex flex-col md:flex-row gap-5">
        <div class="gallery-item group relative overflow-hidden rounded-[var(--radius-lg)] border border-[rgba(17,17,17,0.06)] md:w-[62%]">
          <div class="relative w-full aspect-[4/5]">
            <Image src={img1} alt="Taza de cerámica personalizada con sublimación - BetCraft estudio creativo Maracay" class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-[var(--duration-hover)] ease-[var(--ease-hover)]" />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-[var(--duration-hover)] flex items-end p-6">
            <div class="translate-y-3 group-hover:translate-y-0 transition-transform duration-[var(--duration-hover)] ease-[var(--ease-hover)]">
              <p class="label !text-white/70 !text-[10px] mb-1">Sublimación</p>
              <p class="text-[15px] font-medium text-white">Taza de cerámica</p>
            </div>
          </div>
          <span class="absolute top-3 left-3 label !text-[9px] !text-white/60 bg-black/30 backdrop-blur-sm px-2.5 py-1 rounded-full">Sublimación</span>
        </div>

        <div class="flex flex-row md:flex-col gap-5 md:w-[38%]">
          <div class="gallery-item group relative overflow-hidden rounded-[var(--radius-lg)] border border-[rgba(17,17,17,0.06)] flex-1 md:flex-none">
            <div class="relative w-full aspect-[1/1]">
              <Image src={img2} alt="Mouse pad personalizado con ilustración sublimada - BetCraft Venezuela" class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-[var(--duration-hover)] ease-[var(--ease-hover)]" />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-[var(--duration-hover)] flex items-end p-6">
              <div class="translate-y-3 group-hover:translate-y-0 transition-transform duration-[var(--duration-hover)] ease-[var(--ease-hover)]">
                <p class="label !text-white/70 !text-[10px] mb-1">Sublimación</p>
                <p class="text-[15px] font-medium text-white">Mouse pad personalizado</p>
              </div>
            </div>
            <span class="absolute top-3 left-3 label !text-[9px] !text-white/60 bg-black/30 backdrop-blur-sm px-2.5 py-1 rounded-full">Sublimación</span>
          </div>

          <div class="gallery-item group relative overflow-hidden rounded-[var(--radius-lg)] border border-[rgba(17,17,17,0.06)] flex-1 md:flex-none">
            <div class="relative w-full aspect-[1/1]">
              <Image src={img3} alt="Termo de acero inoxidable con nombre personalizado por sublimación - BetCraft" class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-[var(--duration-hover)] ease-[var(--ease-hover)]" />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-[var(--duration-hover)] flex items-end p-6">
              <div class="translate-y-3 group-hover:translate-y-0 transition-transform duration-[var(--duration-hover)] ease-[var(--ease-hover)]">
                <p class="label !text-white/70 !text-[10px] mb-1">Sublimación</p>
                <p class="text-[15px] font-medium text-white">Termo de acero</p>
              </div>
            </div>
            <span class="absolute top-3 left-3 label !text-[9px] !text-white/60 bg-black/30 backdrop-blur-sm px-2.5 py-1 rounded-full">Sublimación</span>
          </div>
        </div>
      </div>

      <div class="flex flex-col md:flex-row gap-5">
        <div class="flex flex-row md:flex-col gap-5 md:w-[38%]">
          <div class="gallery-item group relative overflow-hidden rounded-[var(--radius-lg)] border border-[rgba(17,17,17,0.06)] flex-1 md:flex-none">
            <div class="relative w-full aspect-[1/1]">
              <Image src={img4} alt="Camiseta personalizada con estampado premium - BetCraft estampados Maracay" class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-[var(--duration-hover)] ease-[var(--ease-hover)]" />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-[var(--duration-hover)] flex items-end p-6">
              <div class="translate-y-3 group-hover:translate-y-0 transition-transform duration-[var(--duration-hover)] ease-[var(--ease-hover)]">
                <p class="label !text-white/70 !text-[10px] mb-1">Estampado</p>
                <p class="text-[15px] font-medium text-white">Camiseta personalizada</p>
              </div>
            </div>
            <span class="absolute top-3 left-3 label !text-[9px] !text-white/60 bg-black/30 backdrop-blur-sm px-2.5 py-1 rounded-full">Estampado</span>
          </div>

          <div class="gallery-item group relative overflow-hidden rounded-[var(--radius-lg)] border border-[rgba(17,17,17,0.06)] flex-1 md:flex-none">
            <div class="relative w-full aspect-[1/1]">
              <Image src={img5} alt="Set de franelas estampadas con diseños personalizados - BetCraft regalos corporativos" class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-[var(--duration-hover)] ease-[var(--ease-hover)]" />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-[var(--duration-hover)] flex items-end p-6">
              <div class="translate-y-3 group-hover:translate-y-0 transition-transform duration-[var(--duration-hover)] ease-[var(--ease-hover)]">
                <p class="label !text-white/70 !text-[10px] mb-1">Estampado</p>
                <p class="text-[15px] font-medium text-white">Set de franelas</p>
              </div>
            </div>
            <span class="absolute top-3 left-3 label !text-[9px] !text-white/60 bg-black/30 backdrop-blur-sm px-2.5 py-1 rounded-full">Estampado</span>
          </div>
        </div>

        <div class="gallery-item group relative overflow-hidden rounded-[var(--radius-lg)] border border-[rgba(17,17,17,0.06)] md:w-[62%]">
          <div class="relative w-full aspect-[4/5]">
            <Image src={img6} alt="Taza artística con ilustración sublimada de alta calidad - BetCraft estudio creativo" class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-[var(--duration-hover)] ease-[var(--ease-hover)]" />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-[var(--duration-hover)] flex items-end p-6">
            <div class="translate-y-3 group-hover:translate-y-0 transition-transform duration-[var(--duration-hover)] ease-[var(--ease-hover)]">
              <p class="label !text-white/70 !text-[10px] mb-1">Sublimación</p>
              <p class="text-[15px] font-medium text-white">Taza artística</p>
            </div>
          </div>
          <span class="absolute top-3 left-3 label !text-[9px] !text-white/60 bg-black/30 backdrop-blur-sm px-2.5 py-1 rounded-full">Sublimación</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({ limitCallbacks: true });

  document.addEventListener('DOMContentLoaded', function () {
    const isMobile = window.innerWidth < 768;

    gsap.fromTo('.gallery-item',
      { y: isMobile ? 25 : 40, opacity: 0 },
      {
        scrollTrigger: {
          trigger: '#gallery-grid',
          start: 'top 85%',
          toggleActions: 'play none none none'
        },
        y: 0,
        opacity: 1,
        duration: 0.9,
        stagger: isMobile ? 0.06 : 0.08,
        ease: 'power3.out'
      }
    );
  });
</script>
