---
import Image from "astro/components/Image.astro";
import img1 from "../assets/header/1.avif";
import img2 from "../assets/header/2.avif";
import img3 from "../assets/header/3.avif";
import img4 from "../assets/header/4.avif";
import img5 from "../assets/header/5.avif";
import img6 from "../assets/header/6.avif";

const slides = [
  { src: img1, alt: "Producto personalizado premium sublimado por BetCraft estudio creativo en Maracay" },
  { src: img2, alt: "Sublimación de alta calidad en tazas y termos - BetCraft Venezuela" },
  { src: img3, alt: "Estampados creativos en prendas premium - BetCraft Maracay" },
  { src: img4, alt: "Impresiones de alta resolución en materiales personalizados - BetCraft" },
  { src: img5, alt: "Regalos corporativos personalizados para empresas - BetCraft Venezuela" },
  { src: img6, alt: "Diseño creativo y producción premium - BetCraft estudio Maracay" },
];
---

<header id="inicio" class="relative min-h-screen flex items-center overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-[var(--page-bg)] via-[var(--page-bg)] to-[rgba(234,88,12,0.03)]"></div>

  <div class="max-w-[1320px] mx-auto px-6 md:px-10 w-full relative z-10 pt-24 pb-16 md:pt-0 md:pb-0">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1fr] gap-12 lg:gap-6 items-center">
      <div id="hero-text" class="flex flex-col gap-7 md:gap-9">
        <div class="flex items-center gap-3">
          <span class="label !text-[var(--highlight)]">Estudio Creativo</span>
          <span class="w-8 h-[1px] bg-[var(--highlight)]"></span>
        </div>

        <h1 class="display">
          Transformamos ideas en <span class="italic text-[var(--accent)]">productos premium</span>
        </h1>

        <p class="body-lg max-w-[460px]">
          Producción creativa de alta calidad para marcas que buscan destacar. Sublimación, estampados e impresiones con estándares de excelencia.
        </p>

        <div class="flex flex-wrap items-center gap-4 mt-1">
          <a href="#contacto" class="btn-dark group">
            Solicitar cotización
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-[var(--duration-hover)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="#portfolio" class="btn-light">
            Ver portafolio
          </a>
        </div>

        <div class="flex items-center gap-8 mt-6 pt-8 border-t border-[rgba(17,17,17,0.08)]">
          <div>
            <p class="font-display text-[28px] font-semibold text-[var(--accent)]">500+</p>
            <p class="label !text-[10px]">Proyectos</p>
          </div>
          <div class="w-[1px] h-10 bg-[rgba(17,17,17,0.1)]"></div>
          <div>
            <p class="font-display text-[28px] font-semibold text-[var(--accent)]">100%</p>
            <p class="label !text-[10px]">Calidad</p>
          </div>
          <div class="w-[1px] h-10 bg-[rgba(17,17,17,0.1)]"></div>
          <div>
            <p class="font-display text-[28px] font-semibold text-[var(--accent)]">24h</p>
            <p class="label !text-[10px]">Respuesta</p>
          </div>
        </div>
      </div>

      <div id="hero-image" class="relative">
        <div class="relative">
          <div id="hero-slider" class="aspect-[4/5] rounded-[var(--radius-xl)] overflow-hidden shadow-[var(--shadow-elevated)] relative">
            {slides.map((slide, i) => (
              <div class={`hero-slide absolute inset-0 ${i === 0 ? 'active' : ''}`} data-index={i}>
                <Image src={slide.src} alt={slide.alt} class="w-full h-full object-cover" loading={i === 0 ? "eager" : "lazy"} />
              </div>
            ))}
          </div>

          <div id="slider-dots" class="flex items-center justify-center gap-2 mt-5">
            {slides.map((_, i) => (
              <button
                class={`slider-dot w-2 h-2 rounded-full transition-all duration-500 ${i === 0 ? 'bg-[var(--accent)] w-6' : 'bg-[var(--accent)]/20 hover:bg-[var(--accent)]/40'}`}
                data-index={i}
                aria-label={`Imagen ${i + 1}`}
              />
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .hero-slide {
    opacity: 0;
    will-change: transform, opacity;
  }
  .hero-slide.active {
    opacity: 1;
  }
</style>

<script>
  import gsap from "gsap";

  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('.hero-slide');
    const dots = document.querySelectorAll('.slider-dot');
    let current = 0;
    const total = slides.length;
    let interval: ReturnType<typeof setInterval>;

    function goToSlide(index: number) {
      if (current === index) return;
      const prev = current;
      const next = index;

      dots[prev].classList.remove('bg-[var(--accent)]', 'w-6');
      dots[prev].classList.add('bg-[var(--accent)]/20');
      dots[next].classList.remove('bg-[var(--accent)]/20');
      dots[next].classList.add('bg-[var(--accent)]', 'w-6');

      const tl = gsap.timeline({
        onComplete: () => {
          slides[prev].classList.remove('active');
          slides[next].classList.add('active');
          gsap.set(slides[prev], { clearProps: 'opacity,scale' });
          gsap.set(slides[next], { clearProps: 'opacity,scale' });
          current = next;
        }
      });

      tl.to(slides[prev], {
        opacity: 0,
        scale: 0.95,
        duration: 0.45,
        ease: 'power2.out'
      })
      .fromTo(slides[next],
        { opacity: 0, scale: 1.08 },
        { opacity: 1, scale: 1, duration: 0.6, ease: 'power3.out' },
        '-=0.2'
      );
    }

    function nextSlide() {
      goToSlide((current + 1) % total);
    }

    function startAutoplay() {
      interval = setInterval(nextSlide, 4000);
    }

    function resetAutoplay() {
      clearInterval(interval);
      startAutoplay();
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = parseInt(dot.getAttribute('data-index') || '0');
        goToSlide(index);
        resetAutoplay();
      });
    });

    startAutoplay();

    // GSAP hero entrance
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    tl.fromTo('#hero-text .label',
      { opacity: 0, y: 15 },
      { opacity: 1, y: 0, duration: 0.5 }
    )
    .fromTo('#hero-text h1',
      { opacity: 0, y: 25 },
      { opacity: 1, y: 0, duration: 0.8 },
      '-=0.2'
    )
    .fromTo('#hero-text .body-lg',
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.6 },
      '-=0.4'
    )
    .fromTo('#hero-text .flex.flex-wrap',
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.6 },
      '-=0.3'
    )
    .fromTo('#hero-text .flex.items-center.gap-8',
      { opacity: 0, y: 15 },
      { opacity: 1, y: 0, duration: 0.6 },
      '-=0.3'
    )
    .fromTo('#hero-image',
      { opacity: 0, x: 30, scale: 0.97 },
      { opacity: 1, x: 0, scale: 1, duration: 1 },
      '-=0.8'
    );
  });
</script>
