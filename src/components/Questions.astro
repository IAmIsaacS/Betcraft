<section id="faq" class="py-28 md:py-40">
  <div class="max-w-[1320px] mx-auto px-6 md:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.4fr] gap-16 lg:gap-24 items-start">
      <div id="faq-left">
        <span class="label mb-5 block">FAQ</span>
        <h2 class="h1 mb-6">Preguntas frecuentes</h2>
        <p class="body-lg max-w-[400px]">
          Resolvemos tus dudas sobre nuestros servicios de producción creativa.
        </p>
      </div>

      <div class="flex flex-col gap-2" id="faq-list">
        <div class="faq-item rounded-[var(--radius-md)] px-5 py-5 hover:bg-[var(--surface)] transition-all duration-[var(--duration-hover)] cursor-default">
          <h3 class="text-[18px] font-semibold text-[var(--text)] mb-2 group-hover:text-[var(--accent)] transition-colors duration-[var(--duration-hover)]">
            ¿Tienen un diseño listo para usar?
          </h3>
          <p class="body-md leading-relaxed">
            ¡Perfecto! Transformamos tus diseños en productos únicos y de alta calidad. Solo envíanoslo y nosotros nos encargamos del resto.
          </p>
        </div>

        <div class="faq-item rounded-[var(--radius-md)] px-5 py-5 hover:bg-[var(--surface)] transition-all duration-[var(--duration-hover)] cursor-default">
          <h3 class="text-[18px] font-semibold text-[var(--text)] mb-2 group-hover:text-[var(--accent)] transition-colors duration-[var(--duration-hover)]">
            ¿Ofrecen garantía en sus productos?
          </h3>
          <p class="body-md leading-relaxed">
            Sí, ofrecemos garantía de satisfacción por 30 días en todos nuestros productos.
          </p>
        </div>

        <div class="faq-item rounded-[var(--radius-md)] px-5 py-5 hover:bg-[var(--surface)] transition-all duration-[var(--duration-hover)] cursor-default">
          <h3 class="text-[18px] font-semibold text-[var(--text)] mb-2 group-hover:text-[var(--accent)] transition-colors duration-[var(--duration-hover)]">
            ¿Puedo personalizar mi pedido?
          </h3>
          <p class="body-md leading-relaxed">
            Claro, ofrecemos opciones completas de personalización. Contáctanos para discutir tu proyecto.
          </p>
        </div>

        <div class="faq-item rounded-[var(--radius-md)] px-5 py-5 hover:bg-[var(--surface)] transition-all duration-[var(--duration-hover)] cursor-default">
          <h3 class="text-[18px] font-semibold text-[var(--text)] mb-2 group-hover:text-[var(--accent)] transition-colors duration-[var(--duration-hover)]">
            ¿Cuáles son los métodos de pago disponibles?
          </h3>
          <p class="body-md leading-relaxed">
            Aceptamos Pago Móvil, Efectivo, PayPal y transferencias bancarias.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({ limitCallbacks: true });

  document.addEventListener('DOMContentLoaded', () => {
    const isMobile = window.innerWidth < 768;
    const left = document.getElementById('faq-left');
    const items = document.querySelectorAll('.faq-item');

    gsap.fromTo(left.querySelectorAll('span, h2, p'),
      { y: isMobile ? 12 : 20, opacity: 0 },
      {
        scrollTrigger: {
          trigger: left,
          start: 'top 85%',
          toggleActions: 'play none none none'
        },
        y: 0,
        opacity: 1,
        duration: 0.8,
        stagger: 0.1,
        ease: 'power3.out'
      }
    );

    gsap.fromTo(items,
      { y: isMobile ? 12 : 20, opacity: 0 },
      {
        scrollTrigger: {
          trigger: '#faq-list',
          start: 'top 85%',
          toggleActions: 'play none none none'
        },
        y: 0,
        opacity: 1,
        duration: 0.7,
        stagger: isMobile ? 0.06 : 0.08,
        ease: 'power3.out'
      }
    );
  });
</script>
